# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5492
DB_NAME=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_MAX_CONNECTIONS=10
DB_SSL=false

# Auth / JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=your_email@example.com
EMAIL_SMTP_PASSWORD=your_email_password
EMAIL_SMTP_FROM=your_email@example.com

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=luxkitchen
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

# Product Images
PRODUCT_IMAGES_MAX_COUNT=6
PRODUCT_IMAGE_MAX_SIZE=5242880 # 5MB
PRODUCT_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp